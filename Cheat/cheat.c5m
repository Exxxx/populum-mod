newritpow
newritual     "Omniscience"
descr "See all things happening on your current plane."
level                  1
apcost -1
multiplane 2
soundfx               23 # Sound effect when the ritual is cast: airduct.smp.
castertarg
scryloc 1000
closewin                 # Closes cast ritual window.
free

newritual     "Godly Endurance"
descr "Regain AP"
level                  1
apcost -6
soundfx               23 # Sound effect when the ritual is cast: airduct.smp.
castertarg
apcost
closewin                 # Closes cast ritual window.
free

newritual     "Travel"
descr "Teleport anywhere"
level                  2
apcost -1
chooseterrloc         -1 # Player chooses the target location
multiplane 2
teleportloc            2 # Teleport caster and army to target location.
soundfx               23 # Sound effect when the ritual is cast: airduct.smp.
closewin                 # Closes cast ritual window.
free

newritual     "Change Team 0"
descr "Places a unit that changes the team of all enemy units if they are charm-able."
level                  2
chooseloc              1 # Player chooses the target location, which may deviate to a location with a horror marked unit.
multiplane 2
setplayer 0
farsummon
addstring     "Change Team"
apcost -1
free

