{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Validate Populum (gainrit)",
      "type": "shell",
      "command": "python py_tools/validate_populum.py",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Validate Populum (fix + describe)",
      "type": "shell",
      "command": "python py_tools/validate_populum.py --fix --describe",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Scan Populum missing sprites",
      "type": "shell",
      "command": "${workspaceFolder}/art_tools/.venv/Scripts/python.exe art_tools/comfyui_run_sprites.py --scan populum/populum.c5m",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Probe COE5 sprite styles (dry-run)",
      "type": "shell",
      "command": "${workspaceFolder}/art_tools/.venv/Scripts/python.exe art_tools/comfyui_probe_sprite_styles.py --dry-run --limit 3",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run COE5 sprite batch (dry-run)",
      "type": "shell",
      "command": "${workspaceFolder}/art_tools/.venv/Scripts/python.exe art_tools/comfyui_run_sprites.py --scan populum/populum.c5m --dry-run",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
